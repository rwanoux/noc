<div class="panneau-mj-contenu">

  <nav class="onglets-mj flexrow">
    <a class="onglet-lien {{#if (eq onglet "individus")}}actif{{/if}}" data-onglet="individus"><i class="fa-solid fa-users"></i> Individus et perditions</a>
    <a class="onglet-lien {{#if (eq onglet "fiel")}}actif{{/if}}" data-onglet="fiel"><i class="fa-solid fa-droplet"></i> Menace et effets de Fiel</a>
  </nav>

  <div class="onglet-mj {{#if (eq onglet "individus")}}actif{{/if}}" data-onglet="individus">
  <!-- CIBLES -->
  <section class="bloc">
    <h3 class="flexrow">
      <span>Personnages</span>
      <a data-action="toutCocher" data-tous="1" data-groupe="personnages" data-tooltip="tout cocher"><i class="fa-solid fa-square-check"></i></a>
      <a data-action="toutCocher" data-tous="0" data-groupe="personnages" data-tooltip="tout décocher"><i class="fa-regular fa-square"></i></a>
    </h3>
    <div class="liste-cibles">
      {{#each personnages as |p|}}
      {{> ligneCibleMJ p}}
      {{else}}
      <p>Aucun personnage dans le monde.</p>
      {{/each}}
    </div>
    <h3 class="flexrow">
      <span>Sur la scène (PNJ, rouages, créatures, Autres)</span>
      <a data-action="toutCocher" data-tous="1" data-groupe="adversaires" data-tooltip="tout cocher"><i class="fa-solid fa-square-check"></i></a>
      <a data-action="toutCocher" data-tous="0" data-groupe="adversaires" data-tooltip="tout décocher"><i class="fa-regular fa-square"></i></a>
    </h3>
    <div class="liste-cibles">
      {{#each adversaires as |p|}}
      {{> ligneCibleMJ p}}
      {{else}}
      <p>Aucun jeton de PNJ sur la scène affichée.</p>
      {{/each}}
    </div>
  </section>

  <!-- PERDITIONS -->
  <section class="bloc">
    <h3>Perditions</h3>
    <label class="option">
      <input type="checkbox" class="reductions" {{#if reductions}}checked{{/if}}>
      Appliquer les réductions (Trauma − Folie, Noirceur − Lumière, Traque − Façade)
    </label>
    <div class="grille-perditions">
      {{#each perditions as |p|}}
      <div class="perdition-ligne">
        <span class="libelle">{{p.label}}{{#if p.reduction}} <em>(− {{p.reduction}})</em>{{/if}}</span>
        <span class="points-ligne">
          <a data-action="points" data-perdition="{{p.cle}}" data-delta="-1" data-tooltip="−1"><i class="fa-solid fa-minus"></i></a>
          <strong class="points">{{p.points}}</strong>
          <a data-action="points" data-perdition="{{p.cle}}" data-delta="1" data-tooltip="+1"><i class="fa-solid fa-plus"></i></a>
        </span>
        <button type="button" data-action="infliger" data-perdition="{{p.cle}}">Infliger</button>
        <button type="button" data-action="soigner" data-perdition="{{p.cle}}">Soigner</button>
      </div>
      {{/each}}
    </div>
  </section>

  </div>

  <div class="onglet-mj {{#if (eq onglet "fiel")}}actif{{/if}}" data-onglet="fiel">
  <!-- FIEL ET MENACE -->
  <section class="bloc">
    <h3>Fiel et Menace</h3>
    <div class="ligne-fiel flexrow">
      <span>Gouttes : <strong>{{fiel.gouttes}}</strong> / 35</span>
      <span>Menace : <strong>{{fiel.menace}}</strong></span>
      <button type="button" data-action="fiel" data-delta="-5">−5</button>
      <button type="button" data-action="fiel" data-delta="-1">−1</button>
      <button type="button" data-action="fiel" data-delta="1">+1</button>
      <button type="button" data-action="fiel" data-delta="5">+5</button>
    </div>
    <div class="etapes-mj flexrow">
      <button type="button" data-action="etapeMJ" data-etape="calme" data-tooltip="Fiel −1">Moment de calme</button>
      <button type="button" data-action="etapeMJ" data-etape="seance" data-tooltip="Menace −1 (Fiel −5)">Début de séance</button>
      <button type="button" data-action="etapeMJ" data-etape="scenario" data-tooltip="Fiel et Menace à 0">Début de scénario</button>
    </div>
  </section>

  <!-- EFFETS DE FIEL -->
  <section class="bloc">
    <h3 class="flexrow">
      <span>Effets de Fiel par niveau de Menace</span>
      <a data-action="bibliotheque" data-tooltip="ouvrir la bibliothèque des effets"><i class="fa-solid fa-book"></i> Bibliothèque</a>
    </h3>
    <label class="option">
      Tirage au sort parmi :
      <select class="categorie-tirage">
        <option value="" {{#unless categorie}}selected{{/unless}}>toutes les catégories</option>
        {{#each categories as |c|}}<option value="{{c}}" {{#if (eq c @root.categorie)}}selected{{/if}}>{{c}}</option>{{/each}}
      </select>
    </label>
    <div class="niveaux-menace">
      {{#each niveaux as |n|}}
      <div class="niveau-ligne {{#unless n.atteint}}non-atteint{{/unless}} {{#if n.actif}}avec-effet{{/if}}">
        <span class="niveau" data-tooltip="{{#if n.atteint}}niveau de Menace atteint{{else}}niveau de Menace non atteint{{/if}}">{{n.niveau}}</span>
        {{#if n.actif}}
          <span class="effet-actif" data-tooltip="{{n.actif.description}}">{{n.actif.nom}}</span>
          <button type="button" data-action="arreterEffet" data-niveau="{{n.niveau}}">Arrêter</button>
        {{else}}
          <select class="choix-effet" data-niveau="{{n.niveau}}" {{#unless n.atteint}}disabled{{/unless}}>
            <option value="">— choisir un effet —</option>
            {{#each n.groupes as |g|}}
            <optgroup label="{{g.categorie}}">
              {{#each g.effets as |e|}}<option value="{{e.id}}" {{#if e.selectionne}}selected{{/if}}>{{e.nom}}</option>{{/each}}
            </optgroup>
            {{/each}}
          </select>
          <button type="button" data-action="tirerEffet" data-niveau="{{n.niveau}}" {{#unless n.atteint}}disabled{{/unless}} data-tooltip="tirer un effet au hasard"><i class="fa-solid fa-dice"></i></button>
          <button type="button" data-action="appliquerEffet" data-niveau="{{n.niveau}}" {{#unless n.atteint}}disabled{{/unless}}>Appliquer</button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    <p class="aide">Un effet s'arrête automatiquement quand la Menace redescend sous son niveau. Les effets immédiats touchent les personnages cochés ; les malus de talents s'appliquent tant que l'effet est actif.</p>
    <div class="lever-etats flexrow">
      <button type="button" data-action="leverEtat" data-etat="fatigue">Lever la fatigue</button>
      <button type="button" data-action="leverEtat" data-etat="bouleversement">Lever l'ancien bouleversement</button>
    </div>
  </section>
  </div>
</div>
