<form class="skill-roll-dialog">
  <header class="roll-dialog-header">

    <h3 class="dialog-roll-title roll-dialog-header">{{#if img}}
        <img
          class="actor-icon"
          src="{{img}}"
          data-edit="img"
          title="{{name}}"
        />
      {{/if}}Provoquer le destin -
      {{title}}
    </h3>
  </header>

  <div class="flexcol">

    {{#if (eq mode "arme")}}
      <h2 class="titre-arme">{{arme.name}}</h2>
      <div class="ligne-grise">
        Combat : {{talent.niveau}} — {{#if (eq arme.type "outil")}}Arme improvisée (non maîtrisée et complexe) : +2{{else}}{{#if arme.system.maitrise}}Arme maîtrisée : +0{{else}}{{#if arme.system.traitsArme.complexe}}Arme non maîtrisée et complexe : +2{{else}}Arme non maîtrisée : +1{{/if}}{{/if}}{{/if}}
      </div>
      <div class="fexrow form-group">
        <span>Niveau requis de base : </span>
        <span>{{niveauBase}}</span>
      </div>

      {{#if arme.system.adistance}}
        <h3>Modificateurs à distance</h3>
        <div class="fexrow form-group">
          <span class="libelle-curseur">Distance : </span>
          <span data-display-range="modDistance">{{#if longuePortee}}Portée courte (10 m){{else}}Portée courte (5 m){{/if}} : +0</span>
          <input class="noc-slider" id="modDistance" value="0" type="range" step="1" min="-1" max="2" list="modDistanceList">
          <datalist id="modDistanceList">
            <option value="-1">{{#if longuePortee}}Bout portant (4 m ou moins){{else}}Bout portant (2 m ou moins){{/if}} : -1</option>
            <option value="0">{{#if longuePortee}}Portée courte (10 m){{else}}Portée courte (5 m){{/if}} : +0</option>
            <option value="1">{{#if longuePortee}}Portée moyenne (20 m){{else}}Portée moyenne (10 m){{/if}} : +1</option>
            <option value="2">{{#if longuePortee}}Portée longue (40 m){{else}}Portée longue (20 m){{/if}} : +2</option>
          </datalist>
        </div>
        <div class="fexrow form-group">
          <span class="libelle-curseur">Couverture : </span>
          <span data-display-range="modCouvert">Aucune couverture : +0</span>
          <input class="noc-slider" id="modCouvert" value="0" type="range" step="1" min="0" max="2" list="modCouvertList">
          <datalist id="modCouvertList">
            <option value="0">Aucune couverture : +0</option>
            <option value="1">Couverture légère : +1</option>
            <option value="2">Couverture importante : +2</option>
          </datalist>
        </div>
      {{/if}}

      <h3>Modificateurs</h3>
        <div class="fexrow form-group">
          <span class="libelle-curseur">Visibilité : </span>
          <span data-display-range="modVisibilite">Pas d'obscurité : +0</span>
          <input class="noc-slider" id="modVisibilite" value="0" type="range" step="2" min="0" max="4" list="modVisibiliteList">
          <datalist id="modVisibiliteList">
            <option value="0">Pas d'obscurité : +0</option>
            <option value="2">Obscurité partielle : +2</option>
            <option value="4">Obscurité totale : +4</option>
          </datalist>
        </div>
        <div class="fexrow form-group">
          <label class="case-cible-sol">
            <input type="checkbox" id="cibleAuSol" {{checked cibleAuSol}}/>
            Cible au sol
          </label>
          <span class="ligne-grise">{{#if arme.system.adistance}}(Difficulté +1){{else}}(Difficulté -1){{/if}}</span>
        </div>
        <div class="fexrow form-group">
          <span class="libelle-curseur">Modificateurs supplémentaires : </span>
          <span data-display-range="modSupplement">+0</span>
          <input class="noc-slider" id="modSupplement" value="0" type="range" step="1" min="-2" max="3" list="modSupplementList">
          <datalist id="modSupplementList">
            <option value="-2">-2</option>
            <option value="-1">-1</option>
            <option value="0">+0</option>
            <option value="1">+1</option>
            <option value="2">+2</option>
            <option value="3">+3</option>
          </datalist>
        </div>
      <h4 class="fexrow form-group niveauFinalRequis">
        <span>Niveau final requis : </span>
        <span><label id="niveauFinalRequis">{{niveauFinalRequis}}</label></span>
      </h4>
    {{/if}}

    {{#if (eq mode "talent")}}
      <h2>
        <span class>Talent : </span>
        <span class>{{talent.label}} ({{talent.niveau}})</span>
      </h2>

      <div class="fexrow form-group">
        <span class>Bonus collaboratif : </span>
        <span data-display-range="nbBonusCollaboratif">0</span>
        <input
          class="noc-slider"
          id="nbBonusCollaboratif"
          value="{{nbBonusCollaboratif}}"
          type="range"
          step="1"
          min="0"
          max="10"
          list="nbBonusCollaboratifList"
        >
        <datalist id="nbBonusCollaboratifList">
          <option value="0">0</option>
          {{#repeat 10}}
            <option value="{{add @index 1}}">{{add @index 1}}</option>
          {{/repeat}}
        </datalist>
      </div>
    {{/if}}

    <div class="fexrow form-group">
      <h4>
        <div class="nbrDes">
          <span class>Dés de domaine : </span>
          <span data-display-range="nbDesDomaine">
            {{domaine.value}}
          </span>
          <i class="fa-light fa-dice-d10"></i>
        </div>
        <div>
          <span class>Domaine : </span>
          <span class>{{domaine.label}} ({{domaine.value}})</span>
        </div>

      </h4>

      <input
        class="noc-slider"
        id="nbDesDomaine"
        value="{{domaine.value}}"
        type="range"
        step="1"
        min="0"
        max="{{domaine.value}}"
        list="nbDesDomaineList"
      >
      <datalist id="nbDesDomaineList">
        <option value="0">0</option>
        {{#repeat domaine.value}}
          <option value="{{add @index 1}}">{{add @index 1}}</option>
        {{/repeat}}
      </datalist>

    </div>

    {{#if cabaleDomaine}}
      <div class="fexrow form-group cabale-dice">
        <h4>
          <div class="nbrDes">
            {{#ifgt cabales.length 1}}
              <span class>Dés de cabale
                <select id="cabaleChoice">
                  {{#each cabales as |c|}}<option value="{{c.id}}">{{c.name}}</option>{{/each}}
                </select> : </span>
            {{else}}
              <span class>Dés de cabale ({{cabaleData.name}}) : </span>
            {{/ifgt}}
            <span data-display-range="nbDesCabale">0</span>
            <i class="fa-light fa-dice-d10"></i>
          </div>
          <div>
            <span class>Domaine cabale : </span>
            <span class="cabale-domaine-texte">{{cabaleDomaine.label}} ({{cabaleDomaine.value}})</span>
          </div>
        </h4>

        <input
          class="noc-slider"
          id="nbDesCabale"
          value="0"
          type="range"
          step="1"
          min="0"
          max="{{cabaleDomaine.value}}"
          list="nbDesCabaleList"
        >
        <datalist id="nbDesCabaleList">
          <option value="0">0</option>
          {{#repeat cabaleDomaine.value}}
            <option value="{{add @index 1}}">{{add @index 1}}</option>
          {{/repeat}}
        </datalist>
      </div>
    {{/if}}

    <div class="flexcol options-jet">
      <label class="case-option {{#unless espoir}}indisponible{{/unless}}">
        <input type="checkbox" id="useEspoir" name="useEspoir" {{checked useEspoir}} {{#unless espoir}}disabled{{/unless}}/>
        <span>Utiliser 1 point d'Espoir (+3 dés)</span>
        <span class="ligne-grise">({{#if espoir}}{{espoir}}{{else}}0{{/if}} disponible{{#ifgt espoir 1}}s{{/ifgt}})</span>
      </label>
      <label class="case-option {{#unless vecu}}indisponible{{/unless}}">
        <input type="checkbox" id="useVecu" name="useVecu" {{checked useVecu}} {{#unless vecu}}disabled{{/unless}}/>
        <span>Utiliser 1 point de Vécu (+1 niveau de talent)</span>
        <span class="ligne-grise">({{#if vecu}}{{vecu}}{{else}}0{{/if}} disponible{{#ifgt vecu 1}}s{{/ifgt}})</span>
      </label>
    </div>
  </div>

</form>